---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrandMark from '../../components/BrandMark.astro';
import LanguageToggle from '../../components/LanguageToggle.astro';
import ActionBar from '../../components/ActionBar.astro';
import Hero from '../../components/Hero.astro';
import BowieCollage from '../../components/BowieCollage.astro';
import BowieStory from '../../components/BowieStory.astro';
import WatchVideo from '../../components/WatchVideo.astro';
import BandGallery from '../../components/BandGallery.astro';
import BandMembers from '../../components/BandMembers.astro';
import UpcomingShows from '../../components/UpcomingShows.astro';
import type { Show } from '../../components/UpcomingShows.astro';
import PastShows from '../../components/PastShows.astro';
import FinalScene from '../../components/FinalScene.astro';
import ExploreLinks from '../../components/ExploreLinks.astro';
import Lightbox from '../../components/Lightbox.astro';
import copy from '../../content/copy.he.json';
import bandMembers from '../../content/band-members.json';
import showsData from '../../content/shows.json';
import { nextShowPill } from '../../lib/shows-ui';

const shows = showsData as Show[];
const today = new Date().toISOString().slice(0, 10);
const pill = nextShowPill(shows, 'he', copy.ui.nextShowLabel, today);
const whatsappHref = `https://wa.me/${copy.contact.whatsappNumber}?text=${encodeURIComponent(copy.contact.whatsappMessage)}`;
---

<BaseLayout locale="he" title={copy.meta.title} description={copy.meta.description}>
  <BrandMark />
  <LanguageToggle locale="he" label={copy.languageToggle.label} ariaLabel={copy.languageToggle.ariaLabel} />
  <ActionBar
    whatsappHref={whatsappHref}
    whatsappLabel={copy.contact.whatsappCta}
    playLabel={copy.ui.playShowreel}
  />
  <main>
    <Hero
      subtitle={copy.hero.subtitle}
      tribute={copy.hero.tribute}
      descriptor={copy.hero.descriptor}
      pill={pill}
    />
    <BandGallery
      locale="he"
      heading={copy.band.heading}
      subheading={copy.band.subheading}
      introParagraph={copy.band.introParagraph}
      enlargeLabel={copy.ui.enlarge}
      readMoreLabel={copy.ui.readMore}
      readLessLabel={copy.ui.readLess}
    />
    <BandMembers
      locale="he"
      statement={copy.band.statement}
      members={bandMembers.filter((m) => m.role === 'core')}
      closeLabel={copy.ui.bandSheetClose}
    />
    <BowieCollage
      locale="he"
      heading={copy.question.heading}
      fragments={copy.question.fragments}
      eras={copy.bowies.eras}
      enlargeLabel={copy.ui.enlarge}
    />
    <BowieStory
      paragraph={copy.bowieStory.paragraph}
      pullQuote={copy.bowieStory.pullQuote}
    />
    <WatchVideo heading={copy.watch.heading} youtubeId="fPsdsE5sYtk" />
    <UpcomingShows
      locale="he"
      heading={copy.upcomingShows.heading}
      emptyLine={copy.upcomingShows.emptyLine}
      emptyCta={copy.upcomingShows.emptyCta}
      ticketsCta={copy.upcomingShows.ticketsCta}
      viewEventCta={copy.upcomingShows.viewEventCta}
      enlargeLabel={copy.ui.enlarge}
      whatsappNumber={copy.contact.whatsappNumber}
      whatsappMessage={copy.contact.whatsappMessage}
      shows={shows}
    />
    <PastShows
      locale="he"
      heading={copy.pastShows.heading}
      shows={shows}
      enlargeLabel={copy.ui.enlarge}
      allShowsLabel={copy.ui.allShows}
      hideShowsLabel={copy.ui.hideShows}
      allYearsLabel={copy.ui.allYears}
    />
    <ExploreLinks
      locale="he"
      heading={copy.explore.heading}
      intro={copy.explore.intro}
      items={copy.explore.items}
    />
    <FinalScene
      line1={copy.final.line1}
      line2={copy.final.line2}
      contactHeading={copy.contact.heading}
      whatsappCta={copy.contact.whatsappCta}
      whatsappNumber={copy.contact.whatsappNumber}
      whatsappMessage={copy.contact.whatsappMessage}
      callCta={copy.contact.callCta}
      phoneDisplay={copy.contact.phoneDisplay}
      copyright={copy.contact.copyright}
      instagramUrl={copy.contact.instagramUrl}
      facebookUrl={copy.contact.facebookUrl}
      youtubeUrl={copy.contact.youtubeUrl}
    />
  </main>
  <Lightbox close={copy.ui.close} prev={copy.ui.prev} next={copy.ui.next} />
</BaseLayout>
