---
import SocialIcon from './SocialIcon.astro';

interface Props {
  line1: string;
  line2: string;
  contactHeading: string;
  whatsappCta: string;
  whatsappNumber: string;
  whatsappMessage: string;
  callCta: string;
  phoneDisplay: string;
  copyright: string;
  instagramUrl?: string;
  facebookUrl?: string;
  youtubeUrl?: string;
}
const {
  line1,
  line2,
  contactHeading,
  whatsappCta,
  whatsappNumber,
  whatsappMessage,
  callCta,
  phoneDisplay,
  copyright,
  instagramUrl,
  facebookUrl,
  youtubeUrl,
} = Astro.props;

const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const telHref = `tel:+${whatsappNumber}`;
const socialLinks = [
  { url: instagramUrl, label: 'Instagram', icon: 'instagram' as const },
  { url: facebookUrl, label: 'Facebook', icon: 'facebook' as const },
  { url: youtubeUrl, label: 'YouTube', icon: 'youtube' as const },
].filter((s) => s.url);
---

<section id="final-scene" class="final has-grain">
  <p class="final__line1" data-reveal>{line1}</p>
  <p class="final__line2" data-reveal style="--reveal-delay: 120ms">{line2}</p>

  <h2 class="final__contact-heading" data-reveal>{contactHeading}</h2>
  <div class="final__ctas" data-reveal style="--reveal-delay: 120ms">
    <a class="final__cta" href={whatsappHref} target="_blank" rel="noopener noreferrer">
      {whatsappCta}
    </a>
    <a class="final__cta final__cta--secondary" href={telHref}>
      {callCta} · {phoneDisplay}
    </a>
  </div>

  {socialLinks.length > 0 && (
    <div class="final__social" data-reveal style="--reveal-delay: 200ms">
      {socialLinks.map((s) => (
        <a href={s.url} target="_blank" rel="noopener noreferrer" aria-label={s.label} class="final__social-link">
          <SocialIcon name={s.icon} size={32} />
        </a>
      ))}
    </div>
  )}

  <img
    src="/assets/logo/stardust-logo.webp"
    alt="Stardust"
    width="1280"
    height="399"
    loading="lazy"
    decoding="async"
    class="final__logo"
    data-reveal
    style="--reveal-delay: 120ms"
  />

  <p class="final__copyright" data-reveal style="--reveal-delay: 200ms">{copyright}</p>
</section>

<style>
  .final {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 1041px;
    min-block-size: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-md);
    background: var(--color-black);
    padding-block: var(--space-xl);
    padding-inline: var(--space-md);
    text-align: center;
  }

  @media (min-width: 1000px) {
    .final {
      contain-intrinsic-block-size: auto 1070px;
    }
  }

  .final__line1,
  .final__line2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-md);
    margin: 0;
  }

  .final__contact-heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-lg);
    margin-block: var(--space-xl) 0;
  }

  .final__ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    margin-block-start: var(--space-md);
  }

  .final__cta {
    font-family: var(--font-mono);
    font-size: var(--size-body);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-black);
    background: var(--color-accent-green);
    padding-block: var(--space-sm);
    padding-inline: var(--space-lg);
    text-decoration: none;
  }

  /* Call CTA reads as secondary next to WhatsApp: outline instead of a
     filled block, so it doesn't compete with the primary action. */
  .final__cta--secondary {
    color: var(--color-off-white);
    background: transparent;
    border: 1px solid var(--color-off-white);
  }

  .final__social {
    display: flex;
    gap: var(--space-sm);
    margin-block-start: var(--space-lg);
  }

  /* Icon bumped to 32px (up from 26px) and the touch target to 48px to
     match, per follow-up request to make the footer icons more visible. */
  .final__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 48px;
    min-block-size: 48px;
    color: var(--color-off-white);
    opacity: 0.7;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .final__social-link:hover,
  .final__social-link:focus-visible {
    opacity: 1;
    transform: scale(1.08);
  }

  .final__logo {
    margin-block-start: var(--space-xl);
    inline-size: 160px;
    block-size: auto;
  }

  .final__copyright {
    margin-block-start: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.04em;
    color: var(--color-off-white);
  }

  @media (prefers-reduced-motion: reduce) {
    .final__social-link {
      transition: none;
    }
  }
</style>
