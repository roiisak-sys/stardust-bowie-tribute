---
import { imageSize } from '../lib/image-size';

export interface Show {
  id: string;
  status: 'past' | 'upcoming';
  dateISO: string;
  venueHe: string;
  venueEn: string;
  cityHe: string;
  cityEn: string;
  posterImage: string;
  eventUrl: string;
  ticketUrl: string;
}
interface Props {
  locale: 'he' | 'en';
  heading: string;
  emptyLine: string;
  emptyCta: string;
  ticketsCta: string;
  viewEventCta: string;
  enlargeLabel: string;
  whatsappNumber: string;
  whatsappMessage: string;
  shows: Show[];
}
const {
  locale,
  heading,
  emptyLine,
  emptyCta,
  ticketsCta,
  viewEventCta,
  enlargeLabel,
  whatsappNumber,
  whatsappMessage,
  shows,
} = Astro.props;

const upcoming = shows.filter((s) => s.status === 'upcoming');
const posterSizes = await Promise.all(
  upcoming.map((s) => (s.posterImage ? imageSize(s.posterImage) : Promise.resolve({ width: 0, height: 0 })))
);
const whatsappHref = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

// The ISO date is parsed as UTC and formatted in UTC, so the build machine's
// timezone can never shift the day.
function parts(iso: string, locale: 'he' | 'en') {
  const d = new Date(`${iso}T00:00:00Z`);
  const tag = locale === 'he' ? 'he-IL' : 'en-US';
  const month = d.toLocaleDateString(tag, { month: 'short', timeZone: 'UTC' });
  return {
    month: locale === 'he' ? month : month.toUpperCase(),
    day: String(d.getUTCDate()).padStart(2, '0'),
    year: String(d.getUTCFullYear()),
    full: d.toLocaleDateString(locale === 'he' ? 'he-IL' : 'en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    }),
  };
}
---

<section id="upcoming-shows" class="upcoming has-grain">
  <h2 class="upcoming__heading">{heading}</h2>

  {upcoming.length === 0 ? (
    <div class="upcoming__empty">
      <p class="upcoming__empty-line">{emptyLine}</p>
      <a class="upcoming__empty-cta" href={whatsappHref} target="_blank" rel="noopener noreferrer">
        {emptyCta}
      </a>
    </div>
  ) : (
    <div class="upcoming__grid">
      {upcoming.map((s, i) => {
        const d = parts(s.dateISO, locale);
        const venue = locale === 'he' ? s.venueHe : s.venueEn;
        const city = locale === 'he' ? s.cityHe : s.cityEn;
        const posterAlt = locale === 'he' ? `כרזה: ${s.venueHe}, ${s.cityHe}` : `Poster: ${s.venueEn}, ${s.cityEn}`;
        return (
          <div class="ticket">
            {s.posterImage ? (
              <button
                type="button"
                class="zoomable"
                data-lightbox="upcoming"
                data-full={s.posterImage}
                data-caption={posterAlt}
                aria-label={enlargeLabel}
              >
                <img
                  src={s.posterImage}
                  alt={posterAlt}
                  width={posterSizes[i].width}
                  height={posterSizes[i].height}
                  loading="lazy"
                  decoding="async"
                  class="ticket__poster"
                />
              </button>
            ) : null}
            <div class="ticket__row">
              <time class="ticket__date" datetime={s.dateISO}>
                <span class="ticket__full">{d.full}</span>
                <span class="ticket__month" aria-hidden="true">{d.month}</span>
                <span class="ticket__day" aria-hidden="true">{d.day}</span>
                <span class="ticket__year" aria-hidden="true">{d.year}</span>
              </time>
              <div class="ticket__info">
                <p class="ticket__venue">{venue}</p>
                <p class="ticket__city">{city}</p>
                {s.ticketUrl ? (
                  <a class="ticket__cta" href={s.ticketUrl} target="_blank" rel="noopener noreferrer">
                    {ticketsCta}
                  </a>
                ) : s.eventUrl ? (
                  <a class="ticket__cta ticket__cta--secondary" href={s.eventUrl} target="_blank" rel="noopener noreferrer">
                    {viewEventCta}
                  </a>
                ) : null}
              </div>
            </div>
          </div>
        );
      })}
    </div>
  )}
</section>

<style>
  .upcoming {
    background: var(--color-black);
    padding: var(--space-xl) var(--space-md);
  }

  .upcoming__heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-lg);
    text-align: center;
    margin: 0 0 var(--space-lg);
  }

  .upcoming__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-md);
    text-align: center;
  }

  .upcoming__empty-line {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--size-display-md);
    margin: 0;
    opacity: 0.7;
  }

  .upcoming__empty-cta {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--size-body);
    color: var(--color-black);
    background: var(--color-accent-green);
    padding: var(--space-sm) var(--space-lg);
    text-decoration: none;
  }

  .upcoming__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 28rem));
    justify-content: center;
    gap: var(--space-md);
    max-inline-size: 72rem;
    margin-inline: auto;
  }

  .ticket {
    display: flex;
    flex-direction: column;
    background: var(--color-charcoal);
    color: var(--color-off-white);
    border: 1px solid #333;
    border-radius: 16px;
    overflow: hidden;
  }

  .ticket__poster {
    inline-size: 100%;
    /* The poster keeps its own proportions (the width/height attributes give
       the ratio), uncropped. */
    block-size: auto;
    display: block;
  }

  .ticket__row {
    display: flex;
    align-items: stretch;
  }

  .ticket__date {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    position: relative;
    flex: none;
    min-inline-size: 5rem;
    padding: var(--space-sm);
    text-align: center;
    background: var(--color-accent-orange);
    color: var(--color-black);
    font-family: var(--font-display);
    font-weight: 800;
    line-height: 1;
  }

  /* The visible parts are decorative; this carries the full date for readers. */
  .ticket__full {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .ticket__month {
    font-size: 0.8125rem;
    letter-spacing: 0.1em;
  }

  .ticket__day {
    font-size: 2.25rem;
    margin-block: 0.25rem;
  }

  .ticket__year {
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
  }

  .ticket__info {
    flex: 1;
    min-inline-size: 0;
    padding: var(--space-sm);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .ticket__venue {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
    line-height: 1.25;
    margin: 0;
  }

  .ticket__city {
    margin: 0.25rem 0 var(--space-sm);
    color: var(--color-off-white);
    opacity: 0.75;
  }

  .ticket__cta {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    margin-block-start: auto;
    padding-inline: var(--space-md);
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--size-label);
    color: var(--color-black);
    background: var(--color-accent-green);
    border-radius: 8px;
    text-decoration: none;
  }

  .ticket__cta--secondary {
    color: var(--color-off-white);
    background: transparent;
    border: 1px solid var(--color-off-white);
  }
</style>
