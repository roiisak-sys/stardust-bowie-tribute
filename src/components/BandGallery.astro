---
import { imageSize } from '../lib/image-size';
import SwipeRow from './SwipeRow.astro';

interface Props {
  locale: 'he' | 'en';
  heading: string;
  subheading: string;
  introParagraph: string;
  enlargeLabel: string;
  readMoreLabel: string;
  readLessLabel: string;
  prevLabel: string;
  nextLabel: string;
}
const { locale, heading, subheading, introParagraph, enlargeLabel, readMoreLabel, readLessLabel, prevLabel, nextLabel } =
  Astro.props;

// Order matters: the first photo is the large highlighted one.
const order = ['05', '02', '03', '04', '01', '06', '07', '08', '09', '10', '11', '12'];
const photos = await Promise.all(
  order.map(async (n) => {
    const src = `/assets/gallery/stardust-bowie-tribute-live-${n}.webp`;
    return { src, ...(await imageSize(src)) };
  })
);
const dominantAlt =
  locale === 'he' ? 'סטארדאסט, מופע מחווה לדיוויד בואי, על הבמה' : 'Stardust, a David Bowie tribute show, live on stage';
---

<section id="band-gallery" class="gallery has-grain">
  <div class="gallery__head">
    <h2 class="gallery__heading">{heading}</h2>
    <p class="gallery__subheading">{subheading}</p>
    <p class="gallery__intro" id="gallery-intro" data-readmore-text>{introParagraph}</p>
    <button
      type="button"
      class="gallery__more"
      data-readmore
      aria-controls="gallery-intro"
      aria-expanded="false"
      data-more={readMoreLabel}
      data-less={readLessLabel}>{readMoreLabel}</button
    >
  </div>

  <SwipeRow label={heading} prevLabel={prevLabel} nextLabel={nextLabel}>
    {photos.map((p, i) => (
      <div class="gallery__item" data-swipe-item>
        <button
          type="button"
          class="zoomable"
          data-lightbox="gallery"
          data-full={p.src}
          data-caption={dominantAlt}
          aria-label={enlargeLabel}
        >
          {i === 0 ? (
            <img
              src={p.src}
              alt={dominantAlt}
              width={p.width}
              height={p.height}
              loading="lazy"
              decoding="async"
              class="gallery__image"
            />
          ) : (
            <img
              src={p.src}
              alt=""
              width={p.width}
              height={p.height}
              loading="lazy"
              decoding="async"
              class="gallery__image"
            />
          )}
        </button>
      </div>
    ))}
  </SwipeRow>
</section>

<style>
  .gallery {
    --swipe-item: 80%;
    --swipe-gap: var(--space-xs);
    background: var(--color-black);
    padding-block: var(--space-xl) var(--space-md);
  }

  .gallery__head {
    padding-inline: var(--space-md);
    text-align: center;
  }

  .gallery__heading,
  .gallery__subheading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-md);
    text-align: center;
    margin: 0;
  }

  .gallery__intro {
    max-inline-size: 42rem;
    margin: var(--space-md) auto var(--space-xs);
    text-align: center;
    font-family: var(--font-body);
    font-size: var(--size-body);
    line-height: 1.6;
    color: var(--color-off-white);
  }

  /* Read more: with JS the intro is clamped to three lines and a toggle shows.
     Without JS the full paragraph stays visible and the button stays hidden. */
  .gallery__more[data-readmore] {
    display: none;
  }

  :global(.js) .gallery__intro[data-readmore-text]:not([data-open]) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
  }

  :global(.js) .gallery__more[data-readmore]:not([hidden]) {
    display: inline-block;
    margin-block-end: var(--space-md);
    padding: 0.5rem 1rem;
    border: 0;
    background: none;
    color: var(--color-accent-orange, #f96949);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }

  .gallery__more:focus-visible {
    outline: 2px solid var(--color-accent-orange, #f96949);
    outline-offset: 2px;
  }

  .gallery__item {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .gallery__item :global(.zoomable) {
    block-size: 100%;
  }

  .gallery__image {
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    @media (hover: hover) and (pointer: fine) {
      .gallery__image {
        transition: transform 0.4s ease;
      }
      .gallery__item:hover .gallery__image {
        transform: scale(1.04);
      }
    }
  }

  @media (min-width: 700px) {
    .gallery {
      --swipe-item: 46%;
    }
  }

  /* Exactly three per view: the item is a third of the room left after two gaps. */
  @media (min-width: 1000px) {
    .gallery {
      --swipe-item: calc((100% - 2 * var(--swipe-gap)) / 3);
    }
  }
</style>

<script>
  // "Read more": toggle the clamped intro. Hides the toggle if the text fits.
  const btn = document.querySelector<HTMLButtonElement>('[data-readmore]');
  const text = document.querySelector<HTMLElement>('[data-readmore-text]');
  if (btn && text) {
    const fits = () => text.scrollHeight <= text.clientHeight + 1;
    const sync = () => {
      if (text.hasAttribute('data-open')) return;
      btn.hidden = fits();
    };
    btn.addEventListener('click', () => {
      const open = btn.getAttribute('aria-expanded') !== 'true';
      btn.setAttribute('aria-expanded', String(open));
      text.toggleAttribute('data-open', open);
      btn.textContent = (open ? btn.dataset.less : btn.dataset.more) ?? '';
    });
    sync();
    if ('fonts' in document) document.fonts.ready.then(sync);
    window.addEventListener('resize', sync);
  }
</script>
