---
// A horizontal scroll-snap row with page dots. The parent marks each child it
// puts in the slot with `data-swipe-item`. Sizing hooks (set on .swipe or any
// parent): --swipe-item (item width, default 82%), --swipe-gap, --swipe-gutter.
// For mouse users (hover + fine pointer, JS on) previous / next buttons scroll
// the row, since the scrollbar is hidden.
interface Props {
  label: string;
  prevLabel: string;
  nextLabel: string;
}
const { label, prevLabel, nextLabel } = Astro.props;
---

<div class="swipe" data-swipe role="group" aria-label={label}>
  <div class="swipe__stage">
    <div class="swipe__track"><slot /></div>
    <button type="button" class="swipe__arrow swipe__arrow--prev" data-swipe-prev aria-label={prevLabel}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5 8 12l7 7"></path></svg>
    </button>
    <button type="button" class="swipe__arrow swipe__arrow--next" data-swipe-next aria-label={nextLabel}>
      <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5 8 12l7 7"></path></svg>
    </button>
  </div>
  <div class="swipe__dots" aria-hidden="true"></div>
</div>

<script>
  import '../scripts/swipe-row';
</script>

<style>
  .swipe {
    inline-size: 100%;
  }

  .swipe__stage {
    position: relative;
  }

  .swipe__track {
    display: flex;
    gap: var(--swipe-gap, var(--space-sm, 1rem));
    overflow-x: auto;
    padding-inline: var(--swipe-gutter, var(--space-sm, 1rem));
    scroll-padding-inline: var(--swipe-gutter, var(--space-sm, 1rem));
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .swipe__track::-webkit-scrollbar {
    display: none;
  }

  .swipe__track > :global([data-swipe-item]) {
    flex: 0 0 var(--swipe-item, 82%);
    min-inline-size: 0;
    scroll-snap-align: start;
  }

  .swipe__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    padding-block-start: var(--space-sm, 1rem);
  }

  .swipe__dots:empty {
    display: none;
  }

  .swipe__dots > :global(span) {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--color-off-white, #f2ede4);
    opacity: 0.3;
    transition:
      opacity 0.25s ease,
      background-color 0.25s ease;
  }

  .swipe__dots > :global(span.on) {
    opacity: 1;
    background: var(--color-accent-orange, #f96949);
  }

  /* Previous / next: hidden unless JS runs on a device with a mouse. A button
     with nowhere to go (start or end of the row) disappears. The chevron points
     toward the side it scrolls, so it is mirrored in RTL and for "next". */
  .swipe__arrow {
    display: none;
    position: absolute;
    z-index: 2;
    inset-block: 0;
    margin-block: auto;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    padding: 0;
    border: 1px solid rgba(242, 237, 228, 0.35);
    border-radius: 50%;
    background: rgba(10, 10, 10, 0.72);
    color: var(--color-off-white, #f2ede4);
    cursor: pointer;
  }

  .swipe__arrow--prev {
    inset-inline-start: var(--space-xs, 0.5rem);
  }

  .swipe__arrow--next {
    inset-inline-end: var(--space-xs, 0.5rem);
  }

  .swipe__arrow svg {
    inline-size: 1.4rem;
    block-size: 1.4rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .swipe__arrow--next svg {
    scale: -1 1;
  }

  :global([dir='rtl']) .swipe__arrow svg {
    scale: -1 1;
  }

  :global([dir='rtl']) .swipe__arrow--next svg {
    scale: 1 1;
  }

  .swipe__arrow[disabled] {
    visibility: hidden;
  }

  .swipe__arrow:hover {
    background: var(--color-accent-orange, #f96949);
    border-color: var(--color-accent-orange, #f96949);
    color: var(--color-black, #0a0a0a);
  }

  .swipe__arrow:focus-visible {
    outline: 2px solid var(--color-accent-orange, #f96949);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    :global(.js) .swipe__arrow {
      display: grid;
    }
  }

  /* Desktop: a centred 72rem column, so the rows show more cards at once. */
  @media (min-width: 1000px) {
    .swipe {
      max-inline-size: 72rem;
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .swipe__dots > :global(span) {
      transition: none;
    }
  }
</style>
