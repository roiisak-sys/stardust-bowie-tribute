---
// Sticky bottom bar for the home pages: the green WhatsApp button (takes the
// remaining width) and a small outlined play button that jumps to the video
// section. Replaces the floating WhatsApp bubble on the home pages only.
import SocialIcon from './SocialIcon.astro';

interface Props {
  whatsappHref: string;
  whatsappLabel: string;
  playLabel: string;
}
const { whatsappHref, whatsappLabel, playLabel } = Astro.props;
---

<div class="action-bar">
  <a class="action-bar__wa" href={whatsappHref} target="_blank" rel="noopener noreferrer">
    <SocialIcon name="whatsapp" size={22} />
    <span>{whatsappLabel}</span>
  </a>
  <a class="action-bar__play" href="#watch" aria-label={playLabel}>
    <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M8 5.5v13l11-6.5z"></path>
    </svg>
  </a>
</div>

<style>
  .action-bar {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 150;
    display: flex;
    gap: 0.75rem;
    align-items: stretch;
    padding-block: 0.75rem calc(0.75rem + env(safe-area-inset-bottom, 0px));
    padding-inline: max(1rem, env(safe-area-inset-left, 0px)) max(1rem, env(safe-area-inset-right, 0px));
    background: linear-gradient(180deg, rgba(10, 10, 10, 0) 0%, rgba(10, 10, 10, 0.88) 38%, var(--color-black) 100%);
    /* The bar spans the viewport; only its two links should take taps. */
    pointer-events: none;
  }

  .action-bar__wa {
    flex: 1;
    pointer-events: auto;
    min-block-size: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    border-radius: 999px;
    background: var(--color-accent-green);
    color: var(--color-black);
    font-family: var(--font-body);
    font-weight: 800;
    font-size: 1rem;
    text-decoration: none;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.45);
  }

  .action-bar__play {
    flex: none;
    pointer-events: auto;
    inline-size: 48px;
    block-size: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    border: 1.5px solid var(--color-off-white);
    color: var(--color-off-white);
    background: rgba(10, 10, 10, 0.6);
  }

  .action-bar__wa:focus-visible,
  .action-bar__play:focus-visible {
    outline: 2px solid var(--color-off-white);
    outline-offset: 3px;
  }

  @media (min-width: 720px) {
    .action-bar {
      justify-content: center;
    }
    .action-bar__wa {
      flex: 0 1 420px;
    }
  }
</style>

<style is:global>
  /* Keep the footer content clear of the fixed bar. */
  body:has(.action-bar) {
    padding-block-end: calc(5rem + env(safe-area-inset-bottom, 0px));
  }
</style>
