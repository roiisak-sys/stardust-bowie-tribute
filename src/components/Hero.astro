---
// The hero logo is an 8 second animation (a light flare sweeping through the
// STARDUST logo, then settling) that plays once and holds on its last frame.
// The video is black outside the logo, and it is blended onto the page with
// `mix-blend-mode: screen`, where black becomes transparent and the glow adds
// light to the concert footage behind it.
interface Props {
  subtitle: string;
  tribute: string;
  descriptor: string;
}
const { subtitle, tribute, descriptor } = Astro.props;
---

<section id="hero" class="hero has-grain">
  <div class="hero__bg" aria-hidden="true">
    <video
      class="hero__bg-video"
      data-hero-bg-video
      poster="/assets/hero/hero-band-live.webp"
      muted
      loop
      playsinline
      preload="none"
      data-video-src="/assets/hero/hero-bg-video-small.mp4"
    ></video>
  </div>
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="hero__brand">
    <video
      class="hero__logo-anim"
      data-hero-logo-anim
      src="/assets/logo/stardust-logo-anim.mp4"
      poster="/assets/logo/stardust-logo-anim-poster.webp"
      data-final-frame="/assets/logo/stardust-logo-anim-final.webp"
      width="960"
      height="960"
      muted
      playsinline
      autoplay
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
    ></video>
    <!-- The H1 carries the real text (the keyword phrase); the animated logo
         above is decoration for the eye. -->
    <h1 class="hero__logo-wrap">
      <span class="hero__h1-text">{subtitle}</span>
    </h1>
  </div>
  <p class="hero__tribute" data-hero-tribute>{tribute}</p>
  <p class="hero__descriptor" data-hero-descriptor>{descriptor}</p>
</section>

<noscript>
  <style is:global>
    #hero .hero__tribute,
    #hero .hero__descriptor,
    #hero .hero__bg-video {
      opacity: 1 !important;
      transform: none !important;
    }
  </style>
</noscript>

<style>
  .hero {
    position: relative;
    height: 100svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
    background: var(--color-black);
  }

  .hero__bg {
    position: absolute;
    inset: -5%;
    z-index: 0;
    overflow: hidden;
  }

  .hero__bg-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    filter: grayscale(0.3) contrast(1.1);
    opacity: 0;
    transform: scale(1.15);
    will-change: transform;
  }

  .hero__scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      linear-gradient(180deg, rgba(10, 10, 10, 0.55) 0%, rgba(10, 10, 10, 0.75) 55%, var(--color-black) 100%),
      radial-gradient(ellipse at center, transparent 0%, rgba(10, 10, 10, 0.4) 100%);
  }

  /* The brand block is the logo's box (the logo settles at 72.8% of the square
     animation frame (it zooms from 66% up to 79% and back during the clip) and
     sits exactly in its centre, so the video is drawn 137.4% as wide as the
     box and centred on it). It must NOT create its own
     stacking context (no z-index here): the video inside blends with the
     concert footage behind it, and a blend only reaches elements outside its
     own stacking context. */
  .hero__brand {
    position: relative;
    width: min(88vw, 640px);
    aspect-ratio: 3.37 / 1;
    margin: 0 0 var(--space-md);
    direction: ltr;
  }

  .hero__logo-wrap {
    margin: 0;
    line-height: 0;
  }

  /* Visually hidden, still read by search engines and screen readers. */
  .hero__h1-text {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /* The animated logo. Black in the video turns transparent with a screen
     blend, so only the lettering and the light show. */
  .hero__logo-anim {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    width: 137.4%;
    height: auto;
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    mix-blend-mode: screen;
    pointer-events: none;
    display: block;
  }

  /* Tier 2: the identity-clarifying line. Bold and tracked, in the same
     accent-orange as the logo's own lightning bolt — deliberately NOT a
     small footnote-style label, since its whole job is telling a
     first-time visitor "this is a David Bowie tribute band" before
     anything else on the page does. */
  .hero__tribute {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-md);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-accent-orange);
    margin: 0;
  }

  /* Tier 3: the fuller hero statement — clearly legible but subordinate to
     the tribute line above it. */
  .hero__descriptor {
    position: relative;
    z-index: 1;
    font-family: var(--font-body);
    font-weight: 500;
    font-size: clamp(1.05rem, 2.6vw, 1.4rem);
    color: var(--color-off-white);
    opacity: 0.85;
    margin: var(--space-sm) 0 0;
  }

  /* Entrance animations run in CSS, not JavaScript: they start on the very
     first paint instead of waiting for the script bundle to download and run.
     That is what makes the logo (the largest element) appear quickly, which
     is the Largest Contentful Paint score Google measures. */
  /* The logo animates itself (it is a video); the lines below fade in under it. */
  .hero__tribute {
    opacity: 0;
    animation: hero-line-in 0.7s cubic-bezier(0.22, 1, 0.36, 1) 1s both;
  }

  .hero__descriptor {
    opacity: 0;
    animation: hero-descriptor-in 0.6s cubic-bezier(0.22, 1, 0.36, 1) 1.35s both;
  }

  @keyframes hero-line-in {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes hero-descriptor-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 0.85;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__tribute,
    .hero__descriptor,
    .hero__bg-video {
      opacity: 1;
      transform: none;
      animation: none;
    }
    .hero__descriptor {
      opacity: 0.85;
    }
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { prefersReducedMotion } from '../scripts/reduced-motion';

  const bgVideo = document.querySelector('[data-hero-bg-video]') as HTMLVideoElement | null;
  const logoAnim = document.querySelector('[data-hero-logo-anim]') as HTMLVideoElement | null;

  if (logoAnim) {
    if (prefersReducedMotion()) {
      // No flare for motion-sensitive visitors: hold the finished, settled
      // frame of the logo as a still image.
      logoAnim.pause();
      logoAnim.removeAttribute('autoplay');
      if (logoAnim.dataset.finalFrame) logoAnim.poster = logoAnim.dataset.finalFrame;
    } else {
      // Autoplay is already on (the file is only about 0.5 MB); this retries
      // if a browser delayed it, and does nothing if it is blocked: the poster
      // frame is the logo, so nothing is lost.
      logoAnim.play().catch(() => {});
    }
  }

  if (prefersReducedMotion()) {
    // Motion-sensitive visitors get the static poster frame, not the
    // looping clip — pause it (the poster still renders as a still image)
    // rather than leaving a moving background running against their
    // stated preference.
    bgVideo?.pause();
  } else {
    // The background clip is a 5 MB file, so it is NOT part of the first
    // paint: the poster (a small WebP) shows immediately and the logo is the
    // largest element on screen. The video is attached only after the page has
    // finished loading and the browser is idle, and not at all for visitors
    // who asked to save data or are on a slow connection. That keeps the
    // mobile Largest Contentful Paint fast, which matters for ranking.
    const connection = (navigator as Navigator & {
      connection?: { saveData?: boolean; effectiveType?: string };
    }).connection;
    const slowOrSaving =
      !!connection && (connection.saveData === true || ['slow-2g', '2g', '3g'].includes(connection.effectiveType ?? ''));

    const startVideo = () => {
      if (!bgVideo || slowOrSaving || bgVideo.dataset.started) return;
      const src = bgVideo.dataset.videoSrc;
      if (!src) return;
      bgVideo.dataset.started = 'true';
      bgVideo.src = src;
      bgVideo.play().catch(() => {
        // Autoplay can be blocked even when muted; the poster frame is a
        // perfectly fine fallback, so there is nothing to recover here.
      });
    };
    const scheduleVideo = () => {
      const idle = (window as Window & { requestIdleCallback?: (cb: () => void, o?: { timeout: number }) => void })
        .requestIdleCallback;
      if (idle) idle(startVideo, { timeout: 2500 });
      else setTimeout(startVideo, 1200);
    };
    if (document.readyState === 'complete') scheduleVideo();
    else window.addEventListener('load', scheduleVideo, { once: true });

    // Use fromTo() rather than from() here: the CSS baseline for these elements is
    // opacity:0 (the site's standard hidden-until-revealed pattern), and from() treats
    // the element's current computed style as its implicit "to" state — which would
    // resolve to opacity:0 and leave the reveal invisible. fromTo() makes the opacity:1
    // destination explicit, matching the pattern used in Story.astro/FinalScene.astro.
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    // Only the background video fades in here. The logo, dust, tribute line
    // and descriptor animate in CSS (see the keyframes above).
    tl.to(bgVideo, { opacity: 1, scale: 1.05, duration: 1.6, ease: 'power2.out' });

    const supportsHoverParallax = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    if (supportsHoverParallax && bgVideo) {
      const hero = document.getElementById('hero');

      hero?.addEventListener('mousemove', (event) => {
        const rect = hero.getBoundingClientRect();
        const relativeX = (event.clientX - rect.left) / rect.width - 0.5;
        const relativeY = (event.clientY - rect.top) / rect.height - 0.5;

        gsap.to(bgVideo, {
          x: relativeX * -20,
          y: relativeY * -20,
          duration: 0.8,
          ease: 'power2.out',
          overwrite: 'auto',
        });
      });

      hero?.addEventListener('mouseleave', () => {
        gsap.to(bgVideo, { x: 0, y: 0, duration: 0.6, ease: 'power2.out', overwrite: 'auto' });
      });
    }
  }
</script>
