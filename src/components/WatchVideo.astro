---
// Showreel section. The YouTube player is NOT in the initial HTML: its ~1 MB of
// third-party JS used to load with the page and wrecked the Lighthouse score.
// Instead a poster (local WebP) with a play control is shown. A click swaps in
// the youtube-nocookie iframe with autoplay; if nobody clicks, the same iframe
// (no autoplay) is injected when the frame nears the viewport, so crawlers and
// scrolling visitors get a real on-page video. Without JS the poster is a plain
// link to the YouTube watch page.
import { imageSize } from '../lib/image-size';

interface Props {
  heading: string;
  youtubeId: string;
  playLabel: string;
}
const { heading, youtubeId, playLabel } = Astro.props;

const title = 'Stardust, David Bowie Tribute Show';
const allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
const poster = '/assets/video/showreel-poster.webp';
const { width, height } = await imageSize(poster);
const watchUrl = `https://www.youtube.com/watch?v=${youtubeId}`;
---

<section id="watch" class="watch has-grain">
  <h2 class="watch__heading" data-reveal>{heading}</h2>
  <div
    class="watch__frame"
    data-reveal
    style="--reveal-delay: 120ms"
    data-video-id={youtubeId}
    data-video-title={title}
    data-video-allow={allow}
  >
    <img class="watch__poster" src={poster} width={width} height={height} alt="" loading="lazy" decoding="async" />
    <a class="watch__facade watch__facade--link" href={watchUrl} target="_blank" rel="noopener noreferrer" aria-label={`${playLabel}: ${title}`}>
      <span class="watch__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor" focusable="false"><path d="M8 5.5v13l11-6.5z"></path></svg>
      </span>
    </a>
    <button class="watch__facade watch__facade--button" type="button" aria-label={`${playLabel}: ${title}`}>
      <span class="watch__play" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="34" height="34" fill="currentColor" focusable="false"><path d="M8 5.5v13l11-6.5z"></path></svg>
      </span>
    </button>
  </div>
</section>

<script>
  // The player is loaded in one of two ways, whichever comes first: a click on
  // the poster (autoplay), or the frame coming near the viewport (no autoplay).
  // Lighthouse never scrolls, so the initial load stays free of the third-party player.
  import { facadeController } from '../lib/video-facade';
  import { initWhenNear } from '../lib/lazy-init';

  document.querySelectorAll<HTMLElement>('.watch__frame[data-video-id]').forEach((frame) => {
    const button = frame.querySelector<HTMLButtonElement>('.watch__facade--button');
    if (!button) return;
    const player = facadeController(frame, () => document.createElement('iframe'), {
      id: frame.dataset.videoId ?? '',
      title: frame.dataset.videoTitle ?? '',
      allow: frame.dataset.videoAllow ?? '',
    });
    button.addEventListener('click', () => player.click(), { once: true });

    if ('IntersectionObserver' in window) {
      initWhenNear([frame], () => player.near(), (callback, options) => new IntersectionObserver(callback, options), '600px 0px');
    } else {
      // No IntersectionObserver: load the player once the page is idle.
      const idle = (window as Window & { requestIdleCallback?: (cb: () => void) => void }).requestIdleCallback;
      if (idle) idle(() => player.near());
      else setTimeout(() => player.near(), 1500);
    }
  });
</script>

<style>
  .watch {
    background: var(--color-black);
    padding-block: var(--space-xl);
    padding-inline: var(--space-md);
  }

  .watch__heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-md);
    text-align: center;
    margin-block: 0 var(--space-lg);
  }

  .watch__frame {
    position: relative;
    max-inline-size: 56rem;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    background: var(--color-charcoal);
  }

  /* The iframe is created by the click script, so it has no Astro scope
     attribute: :global() keeps this rule from being tied to one. */
  .watch__frame :global(iframe) {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
  }

  .watch__poster {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }

  /* Both controls cover the poster. The link is the no-JS fallback, the
     button replaces it once JS runs (the inline head script adds .js). */
  .watch__facade {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    block-size: 100%;
    padding: 0;
    border: 0;
    background: linear-gradient(180deg, rgba(10, 10, 10, 0.1) 0%, rgba(10, 10, 10, 0.45) 100%);
    color: var(--color-off-white);
    cursor: pointer;
    text-decoration: none;
  }

  .watch__facade--button {
    display: none;
  }

  :global(.js) .watch__facade--link {
    display: none;
  }

  :global(.js) .watch__facade--button {
    display: flex;
  }

  .watch__play {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 4.5rem;
    block-size: 4.5rem;
    border-radius: 50%;
    border: 2px solid var(--color-off-white);
    background: rgba(10, 10, 10, 0.6);
  }

  .watch__facade:hover .watch__play {
    border-color: var(--color-accent-orange);
    color: var(--color-accent-orange);
  }

  .watch__facade:focus-visible {
    outline: 3px solid var(--color-off-white);
    outline-offset: -6px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .watch__play {
      transition: transform 0.2s var(--ease-editorial), border-color 0.2s, color 0.2s;
    }
    .watch__facade:hover .watch__play {
      transform: scale(1.08);
    }
  }
</style>
