---
interface Props {
  heading: string;
  youtubeId: string;
}
const { heading, youtubeId } = Astro.props;
---

<section id="watch" class="watch has-grain">
  <h2 class="watch__heading" data-reveal>{heading}</h2>
  <div class="watch__frame" data-reveal style="--reveal-delay: 120ms">
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${youtubeId}`}
      title="Stardust, David Bowie Tribute Show"
      loading="lazy"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
</section>

<style>
  .watch {
    background: var(--color-black);
    padding-block: var(--space-xl);
    padding-inline: var(--space-md);
  }

  .watch__heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-md);
    text-align: center;
    margin-block: 0 var(--space-lg);
  }

  .watch__frame {
    position: relative;
    max-inline-size: 56rem;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    background: var(--color-charcoal);
  }

  .watch__frame iframe {
    position: absolute;
    inset: 0;
    inline-size: 100%;
    block-size: 100%;
    border: 0;
  }
</style>
