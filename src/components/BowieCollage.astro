---
import { imageSize } from '../lib/image-size';
import SwipeRow from './SwipeRow.astro';

interface Era {
  name: string;
  line: string;
  image: string;
}
interface Props {
  locale: 'he' | 'en';
  heading: string;
  fragments: string[];
  eras: Era[];
  enlargeLabel: string;
  prevLabel: string;
  nextLabel: string;
}
const { locale, heading, fragments, eras, enlargeLabel, prevLabel, nextLabel } = Astro.props;

const captionOf = (name: string) => (locale === 'he' ? `דיוויד בואי, ${name}` : `David Bowie, ${name}`);
const sizes = await Promise.all(eras.map((e) => imageSize(e.image)));
---

<section id="bowie-collage" class="collage has-grain">
  <img
    src="/assets/bowie/bowie-wordmark.webp"
    alt="Bowie"
    width="800"
    height="800"
    loading="lazy"
    decoding="async"
    class="collage__wordmark"
  />
  <h2 class="collage__heading">{heading}</h2>
  <p class="collage__fragments">{fragments.join(' · ')}</p>

  <SwipeRow label={heading} prevLabel={prevLabel} nextLabel={nextLabel}>
    {eras.map((era, i) => (
      <div class={`collage__card collage__card--${i}`} data-swipe-item data-reveal>
        <button
          type="button"
          class="zoomable"
          data-lightbox="eras"
          data-full={era.image}
          data-caption={captionOf(era.name)}
          aria-label={`${enlargeLabel}: ${era.name}`}
        >
          <img
            src={era.image}
            alt={captionOf(era.name)}
            width={sizes[i].width}
            height={sizes[i].height}
            loading="lazy"
            decoding="async"
            class="collage__image"
          />
          <span class="collage__label label">{era.name}</span>
        </button>
      </div>
    ))}
  </SwipeRow>
</section>

<style>
  .collage {
    --swipe-item: 62%;
    --swipe-gap: var(--space-xs);
    background: var(--color-black);
    /* Top padding intentionally smaller than the bottom: the wordmark is
       the very first thing after the full-height Hero, and --space-xl
       there read as a big dead gap between the hero and the BOWIE logo. */
    padding-block: var(--space-md) var(--space-xl);
  }

  .collage__wordmark {
    display: block;
    inline-size: min(50vw, 220px);
    block-size: auto;
    margin-block: 0 var(--space-md);
    margin-inline: auto;
  }

  .collage__heading {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: var(--size-display-md);
    text-align: center;
    margin: 0 0 var(--space-sm);
    padding-inline: var(--space-md);
  }

  .collage__fragments {
    font-family: var(--font-mono);
    font-size: var(--size-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    opacity: 0.6;
    margin: 0 0 var(--space-md);
    padding-inline: var(--space-md);
  }

  .collage__card {
    aspect-ratio: 3 / 4;
    overflow: hidden;
  }

  .collage__card :global(.zoomable) {
    position: relative;
    block-size: 100%;
  }

  .collage__image {
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
    filter: grayscale(1);
  }

  /* Label on a bottom gradient to near black, so it reads on any photo. */
  .collage__label {
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0;
    padding: var(--space-lg) var(--space-sm) var(--space-sm);
    background: linear-gradient(to top, rgba(0, 0, 0, 0.92), rgba(0, 0, 0, 0));
    color: var(--color-off-white);
    opacity: 1;
    text-align: start;
    pointer-events: none;
  }

  /* object-fit: cover's default center crop can cut heads off, since a few
     source photos are taller or wider than 3:4. All 8 are well composed with
     the head near the top of the frame, so a top-biased crop keeps the head
     and trims the body/background. Era 1's face sits more centrally, so it
     gets a partial upward bias to keep both hair and face in frame. Era 6 is
     close to its source's native ratio and needs no change. */
  .collage__card--0 .collage__image,
  .collage__card--2 .collage__image,
  .collage__card--3 .collage__image,
  .collage__card--4 .collage__image,
  .collage__card--5 .collage__image,
  .collage__card--7 .collage__image {
    object-position: center top;
  }

  .collage__card--1 .collage__image {
    object-position: 50% 25%;
  }

  @media (min-width: 700px) {
    .collage {
      --swipe-item: 34%;
    }
  }

  /* Exactly four per view: a quarter of the room left after three gaps. */
  @media (min-width: 1000px) {
    .collage {
      --swipe-item: calc((100% - 3 * var(--swipe-gap)) / 4);
    }
  }
</style>
